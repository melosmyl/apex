{
  "name": "Advisor",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "library_key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "short_bio": {
      "type": "string"
    },
    "biography": {
      "type": "string"
    },
    "expertise": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "communication_style": {
      "type": "string"
    },
    "decision_style": {
      "type": "string"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "personality_traits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "system_instructions": {
      "type": "string"
    },
    "avatar": {
      "type": "string"
    },
    "accent": {
      "type": "string"
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "default_provider": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic"
      ],
      "default": "openai"
    },
    "default_model": {
      "type": "string"
    },
    "fallback_provider": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic"
      ]
    },
    "fallback_model": {
      "type": "string"
    },
    "temperature": {
      "type": "number",
      "default": 0.7
    },
    "maximum_output_length": {
      "type": "number",
      "default": 2000
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "ai",
        "human"
      ],
      "default": "ai"
    },
    "email": {
      "type": "string"
    },
    "voice_name": {
      "type": "string"
    },
    "voice_pitch": {
      "type": "number",
      "default": 1
    },
    "voice_rate": {
      "type": "number",
      "default": 0.97
    }
  },
  "required": [
    "company_id",
    "name",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}