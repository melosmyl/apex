{
  "name": "Task",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "review",
        "done"
      ],
      "default": "todo"
    },
    "deliverable": {
      "type": "string"
    },
    "blocker": {
      "type": "string"
    },
    "delegated_back": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "company_id",
    "title"
  ]
}