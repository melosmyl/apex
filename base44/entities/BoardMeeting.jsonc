{
  "name": "BoardMeeting",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "preparing",
        "independent_complete",
        "discussion_complete",
        "challenge_complete",
        "complete",
        "failed"
      ],
      "default": "preparing"
    },
    "independent_responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "advisor_id": {
            "type": "string"
          },
          "advisor_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "provider_used": {
            "type": "string"
          },
          "model_used": {
            "type": "string"
          },
          "used_fallback": {
            "type": "boolean"
          },
          "position": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "key_arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_information": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggested_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence_score": {
            "type": "number"
          }
        }
      }
    },
    "challenge_responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "advisor_id": {
            "type": "string"
          },
          "advisor_name": {
            "type": "string"
          },
          "challenged_advisor": {
            "type": "string"
          },
          "point_challenged": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "revised_position": {
            "type": "string"
          },
          "confidence_score": {
            "type": "number"
          }
        }
      }
    },
    "discussion_transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "round": {
            "type": "number"
          },
          "advisor_id": {
            "type": "string"
          },
          "advisor_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "message_type": {
            "type": "string"
          },
          "reply_to_advisor": {
            "type": "string"
          },
          "changed_opinion": {
            "type": "boolean"
          },
          "new_position": {
            "type": "string"
          },
          "new_risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence_score": {
            "type": "number"
          },
          "provider_used": {
            "type": "string"
          },
          "model_used": {
            "type": "string"
          }
        }
      }
    },
    "discussion_rounds_completed": {
      "type": "number"
    },
    "board_resolution": {
      "type": "object",
      "properties": {
        "executive_summary": {
          "type": "string"
        },
        "decision_question": {
          "type": "string"
        },
        "recommended_direction": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        },
        "areas_of_agreement": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "areas_of_disagreement": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "main_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minority_opinion": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_information": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended_experiment": {
          "type": "string"
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "assigned_to": {
                "type": "string"
              }
            }
          }
        },
        "overall_confidence_score": {
          "type": "number"
        },
        "discussion_evaluation": {
          "type": "object",
          "properties": {
            "strongest_arguments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "disproven_arguments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "uncertain_assumptions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "most_persuasive_advisor": {
              "type": "string"
            },
            "consensus_assessment": {
              "type": "string"
            },
            "opinions_changed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "founder_decision": {
      "type": "string",
      "enum": [
        "pending",
        "accept",
        "reject",
        "modify",
        "undecided",
        "custom"
      ],
      "default": "pending"
    },
    "founder_decision_notes": {
      "type": "string"
    },
    "discussion": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "advisor": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "stance": {
            "type": "string"
          }
        }
      }
    },
    "executive_summary": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "confidence_score": {
      "type": "number"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "minority_opinion": {
      "type": "string"
    },
    "alternative_strategies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assigned_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "assigned_to": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "company_id",
    "question"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}